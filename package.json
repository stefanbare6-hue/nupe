{
  "name": "nupe-estagio",
  "private": true,
  "type": "module",
  "description": "NUPE UNEB Campus XXI — questionários, fichas de campo e relatório de estágio",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @nupe/core && npm run build -w @nupe/api && npm run build -w @nupe/web",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc -b",
    "typecheck:strict": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "capturar": "node scripts/capturar.mjs",
    "reiniciar": "node scripts/reiniciar.mjs",
    "vercel:checa": "node --import ./scripts/furar-fonte.mjs scripts/vercel-checa.mjs",
    "disco:checa": "node --import ./scripts/furar-fonte.mjs scripts/checa-disco.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8"
  }
}
